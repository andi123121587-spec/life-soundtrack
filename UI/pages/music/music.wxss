.detail-page { padding-left: 28rpx; padding-right: 28rpx; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.song-menu-mask { position: fixed; inset: 0; z-index: 48; }
.song-menu { position: fixed; z-index: 50; right: 30rpx; width: 260rpx; padding: 12rpx 0; border: 1.5rpx solid #ddb89f; border-radius: 28rpx; background: #fef7eb; box-shadow: 0 14rpx 34rpx rgba(78,53,36,.15); }
.song-menu view { padding: 22rpx 30rpx; color: #4e3524; font-size: 25rpx; }
.song-menu view + view { border-top: 1rpx solid #f3dfcf; }
.detail-head { margin-top: 44rpx; display: flex; align-items: center; gap: 20rpx; }
.detail-head__cover { width: 136rpx; height: 136rpx; border-radius: 42rpx; flex: none; background: #ead8bc; }
.detail-head__copy { flex: 1; min-width: 0; }
.detail-head__title { display: block; color: #4e3524; font-size: 44rpx; line-height: 1.15; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.detail-head__sub { display: block; margin-top: 8rpx; color: #b88768; font-size: 25rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.detail-head__like { width: 64rpx; height: 64rpx; display: grid; place-items: center; }
.detail-head__like image { width: 46rpx; height: 46rpx; }
.detail-head__like .is-unliked { opacity: .28; filter: grayscale(1); }
.detail-rule { height: 6rpx; margin-top: 42rpx; background: #fce0ad; }
.detail-menu-hint { margin-top: 16rpx; color: #b88768; font-size: 21rpx; }
.detail-tabs { margin-top: 22rpx; display: flex; gap: 30rpx; }
.detail-tab { min-width: 110rpx; }
.lyrics-list { height: 560rpx; margin-top: 42rpx; }
.lyrics-row { min-height: 48rpx; padding: 8rpx 18rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 999rpx; }
.lyrics-row + .lyrics-row { margin-top: 22rpx; }
.lyrics-row image { width: 36rpx; height: 36rpx; }
.lyrics-row--warning { background: #f8dfd8; }
.lyrics-line { color: #9c8b7e; font-size: 29rpx; line-height: 1.45; }
.lyrics-line--active { color: #4e3524; font-size: 32rpx; font-weight: 700; }
.wave-row { height: 76rpx; margin-top: 50rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.wave-bar { width: 10rpx; border-radius: 99rpx; background: #dda47c; transform-origin: center; animation: wavePulse 1.1s ease-in-out infinite; animation-play-state: paused; }
.wave-row--playing .wave-bar { animation-play-state: running; }
.wave-bar:nth-child(2n) { animation-delay: -.2s; }
.wave-bar:nth-child(3n) { animation-delay: -.45s; }
.wave-bar:nth-child(5n) { animation-delay: -.7s; }
@keyframes wavePulse { 0%, 100% { transform: scaleY(.55); opacity: .62; } 50% { transform: scaleY(1.18); opacity: 1; } }
.timeline-slider { margin: 22rpx -10rpx 0; }
.timeline-time { margin-top: -10rpx; display: flex; justify-content: space-between; color: #dfb39a; font-size: 22rpx; }
.player { height: 112rpx; margin-top: 8rpx; padding: 0 30rpx; border-radius: 58rpx; display: grid; grid-template-columns: repeat(5,1fr); align-items: center; justify-items: center; background: #c98659; }
.player > image { width: 48rpx; height: 48rpx; }
.player__muted { opacity: .55; }
.player__center { width: 86rpx; height: 86rpx; border-radius: 50%; display: grid; place-items: center; background: #fce0ad; }
.player__center image { width: 34rpx; height: 44rpx; filter: sepia(1) saturate(1.8) brightness(.7); }
.player__center--disabled { opacity: .5; }
.detail-warning { margin-top: 28rpx; padding: 28rpx 42rpx 32rpx; border-radius: 48rpx; background: #f8dfd8; }
.detail-warning__head { display: flex; align-items: center; gap: 18rpx; color: #a65f4b; font-size: 32rpx; font-weight: 700; }
.detail-warning__head image { width: 42rpx; height: 42rpx; }
.detail-warning__text { display: block; margin-top: 22rpx; color: #d08d77; font-size: 26rpx; line-height: 1.55; }
.warning-actions { margin-top: 28rpx; display: flex; justify-content: space-between; gap: 28rpx; }
.warning-button { flex: 1; min-height: 70rpx; font-size: 28rpx; }
.diary-view { margin-top: 42rpx; }
.diary-view__eyebrow { display: block; color: #a56c49; font-size: 28rpx; }
.diary-view__title { display: block; margin-top: 20rpx; color: #4e3524; font-size: 42rpx; font-weight: 700; }
.diary-view__body { height: 520rpx; margin-top: 24rpx; padding: 42rpx; border-radius: 48rpx; background: #c98659; color: #fef7eb; font-size: 30rpx; line-height: 1.8; }
.diary-view__paragraph { display: block; white-space: pre-wrap; }
.diary-view__paragraph + .diary-view__paragraph { margin-top: 28rpx; }
.diary-view__mood { width: 150rpx; height: 54rpx; margin-top: 24rpx; border: 2rpx solid #966b1f; border-radius: 99rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.diary-view__mood image { width: 30rpx; height: 30rpx; }
