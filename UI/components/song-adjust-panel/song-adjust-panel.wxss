.sheet-mask { position: fixed; inset: 0; z-index: 80; background: rgba(78,53,36,.34); }
.sheet { position: fixed; z-index: 90; left: 0; right: 0; bottom: 0; max-height: 84vh; overflow-y: auto; padding: 26rpx 32rpx calc(38rpx + env(safe-area-inset-bottom)); border-radius: 56rpx 56rpx 0 0; background: #fef7eb; }
.sheet__handle { width: 152rpx; height: 14rpx; margin: 0 auto 28rpx; border-radius: 99rpx; background: #ead5c8; }
.sheet__title { display: block; color: #17100c; font-size: 42rpx; font-weight: 700; }
.tweak { margin-top: 26rpx; }
.tweak__label { display: block; color: #4e3524; font-size: 28rpx; font-weight: 600; }
.tweak slider { margin: 6rpx -10rpx 0; }
.tweak__legend { display: flex; justify-content: space-between; color: #a56c49; font-size: 22rpx; }
.sheet__section { display: block; margin-top: 24rpx; color: #4e3524; font-size: 28rpx; }
.instrument-row { margin-top: 20rpx; display: flex; gap: 12rpx; }
.pill { min-height: 58rpx; padding: 0 24rpx; border: 2rpx solid #966b1f; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; color: #966b1f; font-size: 24rpx; }
.pill--active { background: #966b1f; color: #fef7eb; }
.sheet__preview { height: 88rpx; margin-top: 28rpx; padding: 0 28rpx; border-radius: 44rpx; display: flex; align-items: center; gap: 18rpx; background: #ead0bf; color: #c98659; font-size: 26rpx; }
.sheet__preview--disabled { opacity: .58; }
.sheet__preview > image { width: 30rpx; height: 36rpx; }
.mini-wave { margin-left: auto; display: flex; align-items: center; gap: 4rpx; }
.mini-wave__bar { width: 5rpx; border-radius: 99rpx; background: #d89c72; }
.sheet__apply { height: 106rpx; margin-top: 26rpx; border-radius: 54rpx; display: grid; place-items: center; background: #c98659; color: #fef7eb; font-size: 34rpx; }
