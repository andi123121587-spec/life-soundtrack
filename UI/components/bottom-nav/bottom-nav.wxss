.bottom-nav-wrap {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 40;
}

.bottom-nav {
  position: relative;
  min-height: 112rpx;
  padding: 16rpx 30rpx 14rpx;
  border: 0;
  border-radius: 56rpx;
  background: #c98755;
  color: #f7e7d5;
  overflow: visible;
  box-shadow: 0 14rpx 34rpx rgba(112, 68, 31, .18);
}

.bottom-nav::before {
  content: "";
  position: absolute;
  z-index: 1;
  left: 50%;
  top: -58rpx;
  transform: translateX(-50%);
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #fef7eb;
}

.bottom-nav__group {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}

.bottom-nav__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 100rpx;
  padding-top: 14rpx;
  color: rgba(255, 242, 230, 0.82);
}

.bottom-nav__item--active {
  color: #fff8ef;
  font-weight: 700;
}

.bottom-nav__icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1);
  opacity: .68;
}

.bottom-nav__item--active .bottom-nav__icon {
  opacity: 1;
}

.bottom-nav__label {
  font-size: 22rpx;
}

.bottom-nav__center {
  position: absolute;
  left: 50%;
  top: -42rpx;
  transform: translateX(-50%);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #c98659;
  color: #80552f;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 28rpx rgba(112, 68, 31, 0.22);
  z-index: 3;
}

.bottom-nav__play-icon {
  width: 34rpx;
  height: 46rpx;
}
