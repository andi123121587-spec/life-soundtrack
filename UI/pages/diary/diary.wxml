<view class="app-page generation-page" style="padding-top: {{navTop}}px;">
  <view class="custom-header">
    <view class="custom-header__side" role="button" aria-label="返回" bindtap="goBack" hover-class="tap-control"><image class="custom-header__back" src="/assets/icons/back.svg" mode="aspectFit" /></view>
    <text class="custom-header__date">{{dateLabel}}</text>
    <view class="custom-header__side"><image class="custom-header__menu" src="/assets/icons/menu.svg" mode="aspectFit" /></view>
  </view>

  <block wx:if="{{stage === 'loading'}}">
    <view class="loading-state">
      <view class="loading-ring">
        <view class="loading-ring__ticks"></view>
        <image class="loading-ring__note" src="/assets/icons/music.svg" mode="aspectFit" />
      </view>
      <text class="loading-state__title">正在为你的故事谱曲…</text>
      <text class="loading-state__sub">AI 正在分析你的情感，请稍候</text>
      <view class="loading-progress"><view class="loading-progress__fill" style="width: {{progress}}%;"></view></view>
      <view class="loading-card">
        <text class="loading-card__label">● 歌词生成中 ●</text>
        <text class="loading-card__text">{{draftLine}}</text>
      </view>
      <text class="loading-tags__title">识别到的心情 · 风格</text>
      <view class="loading-tags">
        <block wx:for="{{loadingTags}}" wx:key="*this"><view class="pill {{index === 2 ? 'pill--active' : ''}}">{{item}}</view></block>
      </view>
      <view class="loading-actions">
        <view class="loading-actions__item" role="button" bindtap="goHome">回首页</view>
        <view class="loading-actions__item loading-actions__item--soft" role="button" bindtap="openLibrary">去歌单</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{stage === 'choice'}}">
    <view class="choice-mask"></view>
    <view class="choice-result">
      <image class="choice-result__cover" src="{{song.coverImage}}" mode="aspectFill" />
      <text class="choice-head__eyebrow">这段心情已经写成歌了</text>
      <text class="choice-head__title">{{song.title}}</text>
      <text class="choice-head__sub">{{song.subtitle}}</text>
      <scroll-view class="choice-lyrics" scroll-y enhanced show-scrollbar="{{false}}">
        <block wx:for="{{song.lyrics}}" wx:key="*this"><text>{{item}}</text></block>
      </scroll-view>
    </view>
    <view class="choice-sheet">
      <view class="choice-sheet__handle"></view>
      <text class="choice-sheet__title">要留下这个版本吗？</text>
      <text class="choice-sheet__sub">现在还没有保存。保存后，日记和歌曲会进入你的云端歌单。</text>
      <view class="choice-card choice-card--keep {{isSaving ? 'choice-card--disabled' : ''}}" role="button" aria-label="保存这首并存入歌单" bindtap="keepSong" hover-class="choice-card--pressed">
        <view class="choice-card__icon"><image src="/assets/icons/heart.svg" mode="aspectFit" /></view>
        <view class="choice-card__copy"><text class="choice-card__title">{{isSaving ? '正在保存…' : '保存到歌单'}}</text><text class="choice-card__sub">保存日记、歌词和歌曲，之后可以继续查看和调整。</text></view>
        <view class="choice-card__tag">存入歌单</view>
      </view>
      <view class="choice-card {{isDiscarding ? 'choice-card--disabled' : ''}}" role="button" aria-label="不保存并删除本次生成" bindtap="discardSong" hover-class="choice-card--pressed">
        <view class="choice-card__icon choice-card__icon--soft"><image src="/assets/icons/close.svg" mode="aspectFit" /></view>
        <view class="choice-card__copy"><text class="choice-card__title">不保存这次</text><text class="choice-card__sub">删除本次生成结果和临时音频，原始草稿仍会保留。</text></view>
        <view class="choice-card__tag choice-card__tag--soft">不留记录</view>
      </view>
      <text class="choice-sheet__note">待确认结果会保存在云端生成任务中；确认保存后才会写入日记和歌单。</text>
    </view>
  </block>

  <view wx:else class="generation-error">
    <text class="generation-error__title">{{errorTitle || '刚才的创作没有完成'}}</text>
    <text class="generation-error__sub">{{errorMessage || '可以直接重试，原始草稿仍然保留。'}}</text>
    <text class="generation-error__draft">草稿已保留，不需要重新输入</text>
    <view class="generation-error__actions">
      <view class="btn-primary" role="button" bindtap="retryGeneration">重新生成</view>
      <view class="btn-secondary" role="button" bindtap="goBack">返回修改</view>
    </view>
  </view>
</view>
